{
  "name": "periphery-server",
  "version": "1.0.0",
  "private": true,
  "description": "periphery API (Netlify Functions) + local dev server",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:light": "node dev-server.mjs",
    "check": "node --check functions/*.js && node --check ../web/public/app.js && node --check ../web/public/sw.js"
  },
  "devDependencies": {
    "netlify-cli": "^27.1.0"
  },
  "dependencies": {
    "satellite.js": "^7.1.0"
  }
}
