# Copy to .env for local Netlify dev testing; set the same values in the
# Netlify site UI for production. Never commit real values.
#
# Every *_BASE / *_HOST endpoint URL is REQUIRED: there is no code default
# (see env.js — missing values are rejected at startup). Other settings have
# code defaults; only set them when you need to override.
#
# All endpoints below are PLACEHOLDERS. Replace with your own values before
# use; do not commit real endpoints, hostnames or tokens.

# --- Browser CORS allowlist (comma-separated) ---
ALLOWED_ORIGIN=https://your-frontend.example

# --- Weather / Forecast (open-meteo) ---
OPEN_METEO_BASE=https://YOUR-HOST.example
OPEN_METEO_PATH=/v1/forecast
OPEN_METEO_AQ_BASE=https://YOUR-HOST.example
OPEN_METEO_AQ_PATH=/v1/air-quality
WEATHER_TTL=600
FORECAST_TTL=600
FORECAST_DAYS=4

# --- Moon / Sun (NASA JPL Horizons ephemeris) ---
HORIZONS_BASE=https://YOUR-HOST.example/api/horizons.api
HORIZONS_RTS_STEP=1m TVH
MOON_TTL=86400

# --- Incidents (ArcGIS FeatureServer) — REQUIRED, org-specific ---
ARC_GIS_URL=https://YOUR-ORG.example/arcgis/rest/services/YourService/FeatureServer/0/query
ARC_GIS_TOKEN=
INCIDENT_RADIUS_M=20000
INCIDENT_MAX=12
INCIDENT_TTL=300

# --- Flights (ADS-B) ---
ADSB_BASE=https://YOUR-HOST.example
ADSB_PATH=/api/v2
FLIGHTS_TTL=30
FLIGHT_DEFAULT_DIST=25

# --- Trains (Infraestruturas de Portugal) ---
TRAIN_HOST=YOUR-HOST.example
TRAIN_PATH=/your-service
TRAIN_SVC=SERVICE_A,SERVICE_B
TRAIN_TTL=300
TRAIN_WINDOW_H=3

# --- External IP ---
IPINFO_BASE=https://YOUR-HOST.example
IPINFO_PATH=/json
IPINFO_TOKEN=
IP_TTL=3600

# --- Solar activity (NOAA SWPC GOES products) ---
SWPC_BASE=https://YOUR-HOST.example
SOLAR_TTL=300

# --- Radiation + air quality (APA, Portugal: RADNET / QualAr) ---
APA_GEO_BASE=https://YOUR-HOST.example/getogc/rest/services/Visualizador
RADNET_SERVICE=/sirad/MapServer/1
QAR_SERVICE=/QAR/MapServer/1
QAR_POLUENTES=/QAR/MapServer/0
RADNET_TTL=600
AIRQUALITY_TTL=600
RADNET_MAX=60
# Safecast: global crowd-sourced gamma radiation (fallback outside Portugal)
SAFECAST_BASE=https://YOUR-HOST.example
SAFECAST_PATH=/en-US/measurements.json
SAFECAST_RADIUS_KM=200
SAFECAST_MAX=50
SAFECAST_TTL=900

# --- Earthquakes (USGS GeoJSON feeds) ---
USGS_BASE=https://YOUR-HOST.example/earthquakes/feed/v1.0/summary
USGS_FEED=2.5_day.geojson
EARTHQUAKE_TTL=300
EARTHQUAKE_MAX=8

# --- Lightning (Blitzortung relay) ---
LIGHTNING_BASE=https://YOUR-HOST.example/api/lightning
LIGHTNING_TTL=60
LIGHTNING_MAX=12

# --- Weather warnings (IPMA, Portugal) ---
IPMA_BASE=https://YOUR-HOST.example/open-data
IPMA_WARNINGS_PATH=/forecast/warnings/warnings_www.json
WARNINGS_TTL=300

# --- Satellites (Celestrak TLE + satellite.js SGP4) ---
CELESTRAK_BASE=https://YOUR-HOST.example/NORAD/elements/gp.php
TLE_FALLBACK_BASE=https://YOUR-HOST.example/api/tle
SAT_TTL=300

# --- National grid (REN Data Hub) ---
REN_BASE=https://YOUR-HOST.example/datahubapi/electricity
REN_TTL=600
REN_MAX=96

# --- Seismic activity (IPMA, Portugal) ---
IPMA_SEISMIC_PATH=/observation/seismic/3.json
IPMA_SEISMIC_PATH_AZORES=/observation/seismic/7.json
SEISMIC_TTL=300
SEISMIC_MAX=10
# USGS global feed used as the seismic fallback outside Portugal
SEISMIC_USGS_FEED=all_day.geojson

# --- Fuel prices (DGEG official portal) — REQUIRED ---
DGEG_BASE=https://YOUR-HOST.example
FUEL_PATH=/api/PrecoComb/PMD
FUEL_TTL=3600

# --- Reservoir storage + hydrological alerts (InfoÁgua / APA) — REQUIRED ---
INFOAGUA_BASE=https://YOUR-HOST.example
INFOAGUA_PATH=/pt/seca
INFOAGUA_CHEIAS_PATH=/pt/cheias
ALBUF_GEOM_URL=https://YOUR-HOST.example/getogc/rest/services/Atlas/Atlas_Agua/MapServer/9/query
ALBUF_TTL=43200
ALBUF_MAX_YEARS=1
# TTL (seconds) for the InfoÁgua drought/flood alerts merged into /api/warnings
HYDRO_TTL=3600

# --- Forex (Frankfurter, ECB reference rates) ---
FX_BASE=https://YOUR-HOST.example/v1
FX_TTL=3600
FX_SYMBOLS=USD,GBP,CHF,JPY,BRL,CNY

# --- Lisbon stock index (PSI, via Yahoo Finance) ---
PSI_BASE=https://YOUR-HOST.example/v8/finance/chart
PSI_SYMBOL=PSI20.LS
PSI_TTL=600

# --- Shared upstream fetch ---
UPSTREAM_TIMEOUT_MS=15000
