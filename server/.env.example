# Copy to .env for local Netlify dev testing; set the same values in the
# Netlify site UI for production. Never commit real values.
# Every variable has a code default (see env.js) — only set what you override.

# --- Weather / Forecast (open-meteo) ---
OPEN_METEO_BASE=https://api.open-meteo.com
OPEN_METEO_PATH=/v1/forecast
WEATHER_TTL=600
FORECAST_TTL=600
FORECAST_DAYS=4

# --- Moon / Sun (sunrise-sunset.org) ---
SUNRISE_SUNSET_BASE=https://api.sunrise-sunset.org
SUNRISE_SUNSET_PATH=/v2
MOON_TTL=86400

# --- Incidents (ArcGIS FeatureServer) — REQUIRED, org-specific ---
ARC_GIS_URL=https://services-eu1.arcgis.com/XXXXXXXX/arcgis/rest/services/OcorrenciasSite/FeatureServer/0/query
ARC_GIS_TOKEN=
INCIDENT_RADIUS_M=20000
INCIDENT_MAX=12
INCIDENT_TTL=300

# --- Flights (ADS-B) ---
ADSB_BASE=https://opendata.adsb.fi
ADSB_PATH=/api/v2
FLIGHTS_TTL=30
FLIGHT_DEFAULT_DIST=25

# --- Trains (Infraestruturas de Portugal) ---
TRAIN_HOST=www.infraestruturasdeportugal.pt
TRAIN_PATH=/negocios-e-servicos
TRAIN_SVC=INTERNACIONAL,%20ALFA,%20IC,%20IR,%20REGIONAL,%20URB%7CSUBUR,%20ESPECIAL,%20MERCADORIAS,%20SERVI%C3%87O
TRAIN_TTL=300
TRAIN_WINDOW_H=3

# --- External IP ---
IPINFO_BASE=https://ipinfo.io
IPINFO_PATH=/json
IPINFO_TOKEN=
IP_TTL=3600

# --- Radiation (APA RADNET) + Air quality (APA QualAr) ---
APA_GEO_BASE=https://sniambgeoogc.apambiente.pt/getogc/rest/services/Visualizador
RADNET_SERVICE=/sirad/MapServer/1
QAR_SERVICE=/QAR/MapServer/1
QAR_POLUENTES=/QAR/MapServer/0
RADNET_TTL=600
AIRQUALITY_TTL=600
RADNET_MAX=60

# --- Earthquakes (USGS) ---
USGS_BASE=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary
USGS_FEED=2.5_day.geojson
EARTHQUAKE_TTL=300
EARTHQUAKE_MAX=8

# --- Lightning (Blitzortung via pocketworld.org relay) ---
LIGHTNING_BASE=https://pocketworld.org/api/lightning
LIGHTNING_TTL=60
LIGHTNING_MAX=12

# --- Weather warnings (IPMA, Portugal) ---
IPMA_BASE=https://api.ipma.pt/open-data
IPMA_WARNINGS_PATH=/forecast/warnings/warnings_www.json
WARNINGS_TTL=300

# --- Satellites (Celestrak TLE + satellite.js SGP4) ---
CELESTRAK_BASE=https://celestrak.org/NORAD/elements/gp.php
SAT_TTL=300

# --- National grid (REN Data Hub) ---
REN_BASE=https://servicebus.ren.pt/datahubapi/electricity
REN_TTL=600
REN_MAX=96

# --- Seismic activity (IPMA) ---
IPMA_SEISMIC_PATH=/observation/seismic/3.json
IPMA_SEISMIC_PATH_AZORES=/observation/seismic/7.json
SEISMIC_TTL=300
SEISMIC_MAX=10

# --- Fuel prices (API Aberta / DGEG) ---
APIABERTA_BASE=https://api.apiaberta.pt
FUEL_PATH=/v1/fuel/prices
FUEL_TTL=3600
FUEL_MAX=50

# --- Forex (Frankfurter / ECB) ---
FX_BASE=https://api.frankfurter.dev/v1
FX_TTL=3600
FX_SYMBOLS=USD,GBP,CHF,JPY,BRL,CNY

# --- Lisbon stock index (PSI via Yahoo Finance) ---
PSI_BASE=https://query1.finance.yahoo.com/v8/finance/chart
PSI_SYMBOL=PSI20.LS
PSI_TTL=600

# --- Shared upstream fetch ---
UPSTREAM_TIMEOUT_MS=15000

# --- Browser CORS allowlist (comma-separated; defaults to https://jpdias.me) ---
ALLOWED_ORIGIN=https://jpdias.me
